            VALUE "FileVersion", "1.0.1"
            VALUE "ProductName", "UltimateDesktopEffects"
            VALUE "ProductVersion", "1.0.1"
            VALUE "OriginalFilename", "UltimateDesktopEffects.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
